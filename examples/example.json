{
    "global_pattern": "[%Y-%m-%dT%T%z] [%L] <%n>: %v",
    "sink": [
        {
            "name": "console_st",
            "type": "stdout_sink_st"
        },
        {
            "name": "file_out",
            "type": "basic_file_sink_st",
            "filename": "log/spdlog_setup.log",
            "level": "info"
        }
    ],
    "pattern": [
        {
            "name": "succient",
            "value": "%c-%L: %v"
        }
    ],
    "logger": [
        {
            "name": "root",
            "sinks": ["console_st", "file_out"],
            "level": "trace"
        },
        {
            "name": "console",
            "sinks": ["console_st"],
            "pattern": "succient"
        }
    ]
}
